# Exemplo de configuração de variáveis de ambiente para a Loja Virtual Nexo
# Copie este arquivo para .env e ajuste os valores conforme o seu ambiente local:
#   copy .env.example .env

# Chave secreta da aplicação Flask (substitua por uma chave forte em produção)
SECRET_KEY=troque-por-uma-chave-secreta-forte-em-producao

# URL de conexão com o PostgreSQL usando o driver psycopg 3
# Formato: postgresql+psycopg://<USUARIO>:<SENHA>@<HOST>:<PORTA>/<BANCO>
# Exemplo com o usuário 'nexo_user' e o banco 'nexo_db':
DATABASE_URL=postgresql+psycopg://nexo_user:sua_senha_aqui@localhost:5432/nexo_db

# Ambiente do Flask (development ou production)
FLASK_ENV=development
FLASK_DEBUG=1
